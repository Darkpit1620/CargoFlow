# Example environment variables. Do not store real passwords in Git.
# Default local development uses SQLite. PostgreSQL is optional.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Africa/Nairobi
# For deployment set DJANGO_DEBUG=0 and provide DJANGO_SECRET_KEY.
# DJANGO_SECRET_KEY=replace-with-a-random-secret
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# PostgreSQL connection (only used if PGDATABASE is set):
# PGDATABASE=cargoflow
# PGUSER=postgres
# PGPASSWORD=replace-this
# PGHOST=localhost
# PGPORT=5432
